# Copy this file to /opt/futboligy/.env on the EC2 host and replace every secret.

POSTGRES_DB=globalscout
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password

Jwt__Issuer=GlobalScout
Jwt__Audience=GlobalScout
Jwt__SigningKey=replace-with-at-least-32-random-characters

AdminSeed__Email=
AdminSeed__Password=

Authentication__FrontendBaseUrl=https://futboligy.com
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Facebook__ClientId=
Authentication__Facebook__ClientSecret=

# SES uses the EC2 instance role; leave AccessKey/SecretKey unset.
Email__Provider=Ses
Email__Region=eu-central-1
Email__FromAddress=no-reply@futboligy.com

Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__PublishableKey=
Stripe__PremiumPriceId=
Stripe__PublicAppBaseUrl=https://futboligy.com

ApiFootball__ApiKey=
ApiFootball__Host=v3.football.api-sports.io
ApiFootball__BaseUrl=https://v3.football.api-sports.io

ObjectStorage__Provider=S3
ObjectStorage__BucketName=futboligy-prod-media
ObjectStorage__Region=eu-central-1
ObjectStorage__ForcePathStyle=false
ObjectStorage__CreateBucketIfMissing=false

HTTP_PORT=80
